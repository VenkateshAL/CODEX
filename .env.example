# Required
RTSP_URL=rtsp://username:password@192.168.1.100:554/stream1
TELEGRAM_BOT_TOKEN=1234567890:YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=123456789

# Detection settings
MODEL_PATH=yolov8n.pt
TARGET_CLASS_NAME=elephant
CONFIDENCE_THRESHOLD=0.45
FRAMES_BETWEEN_INFERENCE=4
NOTIFICATION_COOLDOWN_SEC=45

# Paths
SNAPSHOTS_DIR=./snapshots
LOGS_DIR=./logs
SNAPSHOT_IMAGE_QUALITY=90
