[Unit]
Description=Elephant Detector (IP Camera -> Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/elephant-detector
ExecStart=/opt/elephant-detector/run_detector.sh
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
